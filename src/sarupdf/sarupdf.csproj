<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SaruPDF</AssemblyName>
    <Product>SaruPDF</Product>
    <Title>SaruPDF</Title>
    <RootNamespace>SaruPdf</RootNamespace>
    <Version>0.2.1</Version>
    <ApplicationIcon>../../assets/SaruPDF.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Yu Gothic UI, 10pt</ApplicationDefaultFont>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/SaruPDF.ico" LogicalName="SaruPdf.Assets.App.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4314.35]" />
    <InternalsVisibleTo Include="sarupdf.Tests" />
  </ItemGroup>
</Project>
